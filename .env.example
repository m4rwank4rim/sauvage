# Fleeca Bank Payment Gateway Configuration
# Mode: 0 = sandbox (simulated, no real balance change), 1 = live
FLEECA_API_KEY=sandbox_secret_key_demo
FLEECA_MODE=0
FLEECA_BASE_URL=https://banking.gta.world
FLEECA_REDIRECT_URL=http://localhost:3000/payment/result
FLEECA_CALLBACK_URL=http://localhost:3000/api/webhooks/fleeca

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth.js (Discord OAuth) — required for admin + client portals
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret_here
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret

# Comma-separated list of Discord user IDs allowed to access /admin
# (Discord IDs are 17-19 digit numbers; enabled via Developer Mode -> Copy User ID)
ADMIN_DISCORD_IDS=

# Discord webhook URL for payment / contact / new-request notifications.
# Leave empty to disable Discord notifications.
DISCORD_WEBHOOK_URL=

# Upstash Redis (Vercel KV) — REQUIRED on Vercel, optional locally.
# When unset, the app uses data/agency.json on local disk (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
